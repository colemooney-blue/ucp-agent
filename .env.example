# Copy to .env and fill in. NEVER commit .env. Never paste these into a chat.
#
# --- Task 1: credentials -------------------------------------------------
# Dev Dashboard (https://dev.shopify.com/dashboard) -> Catalogs
#   -> API KEY panel -> Client ID / Client secret (use the copy icons)
CLIENT_ID=
CLIENT_SECRET=

# --- Task 3: catalog ----------------------------------------------------
# TWO different values. Don't conflate them.
#
# CATALOG_ENDPOINT is already correct in src/config.js:
#   https://catalog.shopify.com/api/ucp/mcp
# Shared across all catalogs, not per-catalog. Only set this to override.
# CATALOG_ENDPOINT=

# CATALOG_ID = which saved catalog to scope results to. Shown in the
#   Search preview -> Request -> JSON tab as catalog.catalog_id.
#   Optional: leave blank to search all of Shopify unscoped.
CATALOG_ID=01m12pshmzvsegrbkee7xjksbv

# --- Task 3: merchant override (optional) -------------------------------
# Normally unset. The demo derives the merchant from the seller on whichever
# product the buyer picks, which is what a cross-merchant agent must do.
# Set this only to force every cart at one specific store.
# MERCHANT_ORIGIN=https://some-store.myshopify.com

# --- Task 2: profile (optional) -----------------------------------------
# Defaults to Shopify's hosted fixture, so nothing needs hosting to run.
# Set this once you publish your own ucp-profile.json.
# AGENT_PROFILE=https://your-domain.example.com/.well-known/ucp
